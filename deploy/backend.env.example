# Copy to /www/wwwroot/circular/backend/.env and replace every CHANGE_ME value.
SECRET_KEY=CHANGE_ME_LONG_RANDOM_VALUE
JWT_SECRET_KEY=CHANGE_ME_DIFFERENT_LONG_RANDOM_VALUE
JWT_ACCESS_MINUTES=60

# URL-encode special characters in the database password.
DATABASE_URL=mysql+pymysql://circular_app:CHANGE_ME@127.0.0.1:3306/circular_management?charset=utf8mb4
FRONTEND_ORIGIN=https://circular.example.com
REPORT_BANK_NAME=Bank Compliance Office

UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=20
MODEL_CACHE_DIR=model_cache

USE_LLM_SUMMARY=true
USE_LLM_CHAT=true
RAG_MIN_RELEVANCE=0.25
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=900
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_CTX=8192
# Set both to 0 on a CPU-only VPS. Remove these lines to let Ollama use a GPU.
OLLAMA_NUM_GPU=0
OLLAMA_CHAT_NUM_GPU=0

